# Imagem base com CUDA e ferramentas de desenvolvimento
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Instala Python e compiladores necessários para o insightface
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    ffmpeg libsm6 libxext6 build-essential \
    cmake git wget && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Prepara as ferramentas de build do Python
RUN pip3 install --upgrade pip setuptools wheel cython

# Instala dependências (Numpy primeiro para evitar conflitos de compilação)
COPY requirements.txt .
RUN pip3 install numpy==1.24.3
RUN pip3 install -r requirements.txt

# O código é copiado, mas as pastas photos e models serão sobrescritas por volumes
COPY . .

EXPOSE 8765
CMD ["python3", "server_ws.py"]